# Prisma / app
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notionback?schema=public"
FRONT_URL="http://localhost:3000"
CORS_ORIGINS='http://localhost:3000'
PORT=8000

# Redis (локально)
REDIS_HOST='localhost'
REDIS_PORT=6379

# S3 / MinIO (локальный dev — minio из docker-compose)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="notion-attachments"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Публичная база для чтения файлов (endpoint + bucket)
S3_PUBLIC_URL="http://localhost:9000/notion-attachments"

# Attachments (лимиты в байтах, presign в секундах)
ATTACHMENT_IMAGE_MAX_BYTES=10485760
ATTACHMENT_VIDEO_MAX_BYTES=26214400
ATTACHMENT_PRESIGN_EXPIRES_SECONDS=300

# Auth (обязательно поменяй на реальные секреты)
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000
JWT_ACCESS_SECRET='change_me_access_token'
JWT_REFRESH_SECRET='change_me_refresh_token'

BCRYPT_SALT_ROUNDS=10

MAX_WORKSPACES_PER_USER=3
MAX_PAGE_CONTENT_BYTES=1048576

# Invite links (время жизни временной ссылки в секундах, 24 часа)
INVITE_TTL_SECONDS=86400
MAX_INVITES_PER_WORKSPACE=10

# Docker Compose (для docker-compose.yml)
POSTGRES_DB=notionback
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=8000