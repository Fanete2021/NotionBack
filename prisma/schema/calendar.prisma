model CalendarEvent {
  id          String   @id @default(uuid())
  workspaceId String
  projectId   String?
  title       String
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reminderMinutes  Int?
  telegramReminder Boolean @default(false)
  reminderUserId   String?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?  @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  reminderUser User?     @relation("EventReminderUser", fields: [reminderUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
  @@index([workspaceId, projectId])
  @@map("calendar_events")
}
