{
  "uid": "notion-activity",
  "title": "Активность",
  "description": "События продукта из логов notionback-api. Считаются строки pino с полем action. В проде debug не пишется, поэтому видны info, warn и error. Цифры в карточках — за выбранный сверху период. Графики — сколько событий попало в один шаг, обычно минуту.",
  "tags": [
    "notion",
    "activity"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Окружение",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({service=\"notionback-api\"}, env)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "host",
        "label": "Хост",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({service=\"notionback-api\", env=~\"$env\"}, host)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Люди",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
