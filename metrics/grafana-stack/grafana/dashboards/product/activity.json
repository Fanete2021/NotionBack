            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=\"notionback-api\", env=~\"${env}\", host=~\"${host}\", level=\"info\"} | json action=\"action\" | action=\"user_register\" [$__range]))",
