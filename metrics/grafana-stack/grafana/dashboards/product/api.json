        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(15, sum by (path) (count_over_time({service=\"notionback-api\", env=~\"${env}\", host=~\"${host}\"} |~ \"\\\"responseTime\\\":\" != \"/api/health\" | json path=\"req.url\" | path!=\"\" [$__range])))",
          "queryType": "instant"
        }
