    {
      "id": 11,
      "type": "table",
      "title": "Частые пути",
      "description": "Полный req.url без healthcheck. UUID страниц и воркспейсов остаются в пути, поэтому одна и та же ручка с разными id выглядит как разные строки.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 29
      },
