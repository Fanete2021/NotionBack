          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service=\"notionback-api\", env=~\"${env}\", host=~\"${host}\"} |~ \"\\\"responseTime\\\":\" != \"/api/health\" | regexp \"\\\"responseTime\\\":(?P<took>[0-9.]+)\" | unwrap took [$__range])",
