    {
      "id": 8,
      "type": "timeseries",
      "title": "Ответы по статусу",
      "description": "Сколько ответов каждого кода попало в один шаг графика. Это не накопительный итог и не «за час».",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (status) (count_over_time({service=\"notionback-api\", env=~\"${env}\", host=~\"${host}\"} |~ \"\\\"responseTime\\\":\" != \"/api/health\" | regexp \"\\\"statusCode\\\":(?P<status>[0-9]{3})\" | status!=\"\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{status}}"
        }
