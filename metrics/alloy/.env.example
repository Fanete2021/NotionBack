# Монтируется в /logs:ro. logger.alloy сейчас читает stdout контейнеров,
# этот каталог понадобится, когда появятся файловые логи.
EXTRA_LOGS_DIR=/var/log

# Имена сервисов в сети notion-obs. grafana-stack должен быть уже запущен.
LOKI_URL=http://loki:3100/loki/api/v1/push
METRICS_URL=http://victoria-metrics:8428/api/v1/write

# host у логов, instance у метрик. PT_HOST обязателен.
# Короткое имя этой машины, без домена. На сервере: hostname -s
# Вывод команды и есть значение. Пример: PT_HOST=notion-1
# PT_TZ — запасной пояс; время точки берётся из поля time у pino, иначе время приёма.
PT_ENV=prod
PT_HOST=
PT_TZ=Europe/Moscow
