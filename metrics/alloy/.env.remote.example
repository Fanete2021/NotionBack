# Для Alloy на машине без сети notion-obs. Рядом с docker-compose.remote.yml, имя файла .env.

EXTRA_LOGS_DIR=/var/log

# IP машины, где крутится Grafana. Порты 3100 и 8428 открыты только для этого хоста.
LOKI_URL=http://<IP-сервера-grafana>:3100/loki/api/v1/push
METRICS_URL=http://<IP-сервера-grafana>:8428/api/v1/write

# PT_HOST — имя этой машины: hostname -s
PT_ENV=prod
PT_HOST=
PT_TZ=Europe/Moscow
