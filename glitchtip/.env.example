# GlitchTip self-hosted (error tracking).
# На сервере скопируй в glitchtip/.env — его читает env_file в docker-compose.yml
# (`cd glitchtip && docker compose up -d`). Имена переменных — нативные для GlitchTip.

# Секрет приложения. Обязателен в проде: openssl rand -hex 32
SECRET_KEY=

# URL, по которому веб-интерфейс открывается В БРАУЗЕРЕ (для ссылок и CSRF при логине).
# С доменом+прокси:  https://sentry.example.com
# Напрямую по IP:порт: http://<IP_сервера>:8080
GLITCHTIP_DOMAIN=http://<IP_сервера>:8080

# Открытая регистрация. После создания первого админа выставить false.
ENABLE_OPEN_USER_REGISTRATION=false

# Порт веб-интерфейса на хосте
GLITCHTIP_PORT=8080
